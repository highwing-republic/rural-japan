{
  "name": "rural-japan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "dev:lan": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "build:public": "astro build --mode public",
    "build:sample": "astro build --mode sample",
    "preview": "astro preview --host 127.0.0.1",
    "preview:public": "astro preview --host 127.0.0.1 --mode public",
    "lint": "eslint .",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "test:build": "node --test tests/build/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "1.5.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
