---
import BaseLayout from './BaseLayout.astro';
import Photo from '../components/Photo.astro';
import GuideCard from '../components/GuideCard.astro';
import type { Region } from '../data/regions';
import { getRegionGuidePages, type RegionGuidePage } from '../data/guide-pages';

interface Props { region: Region; page: RegionGuidePage }
const { region, page } = Astro.props;
const pages = getRegionGuidePages(region);
const directory = page.kind === 'directory' ? page.section : undefined;
const title = directory?.title ?? (page.kind === 'specialties' ? 'Local products' : 'Getting to Neba');
const introduction = directory?.introduction ?? (page.kind === 'specialties'
  ? 'Food and ingredients shaped by mountain water, clear air and the rhythm of the seasons.'
  : region.accessNote);
---
<BaseLayout title={`${title} in ${region.name}`} description={introduction}>
  <section class="guide-page-opening section-wrap" id="top">
    <p class="guide-breadcrumb"><a href="/#places">All places</a><span>／</span><a href={`/places/${region.slug}/`}>{region.name} guide</a><span>／</span>{title}</p>
    <div class="guide-page-title"><div><p class="eyebrow">{region.name.toUpperCase()}, {region.prefecture.toUpperCase()}</p><h1>{title}</h1><p>{introduction}</p></div><span lang="ja">{region.japaneseName}</span></div>
  </section>
  <div class="guide-page-hero"><Photo id={page.image} eager sizes="100vw" caption={`${title} · ${region.name}, ${region.prefecture}`} /></div>
  <nav class="guide-page-nav section-wrap" aria-label={`${region.name} visitor guide`}>
    <a href={`/places/${region.slug}/`}>Overview</a>
    {pages.map(item => <a href={`/places/${region.slug}/${item.slug}/`} aria-current={item.slug === page.slug ? 'page' : undefined}>{item.navLabel}</a>)}
  </nav>

  {directory && <section class="guide-page-content section-wrap">
    <header><p class="eyebrow">{directory.label}</p><h2>Places to know<br /><em>before you go.</em></h2><p>These concise notes are written for trip planning. Follow each official listing for the latest details, then confirm opening dates, reservations and local conditions directly.</p></header>
    <div class="guide-grid guide-page-grid">{directory.items.map((item, i) => <GuideCard item={item} index={i} />)}</div>
  </section>}

  {page.kind === 'specialties' && <section class="guide-page-content section-wrap">
    <header><p class="eyebrow">TASTE OF THE MOUNTAINS</p><h2>Grown and made<br /><em>in Neba.</em></h2><p>Availability changes with the season. Village shops and Neverland on Route 153 are useful places to begin looking.</p></header>
    <div class="specialty-list guide-specialty-list">{region.specialties.map((item, i) => <article><span>{String(i + 1).padStart(2, '0')}</span><div><p lang="ja">{item.japaneseName}</p><h3>{item.name}</h3><p>{item.description}</p>{item.whereToFind && <p class="where-to-find"><strong>Where to find it</strong>{item.whereToFind}</p>}</div></article>)}</div>
    <a class="text-link" href="https://neba-nagano.com/?page_id=1535">Official product information <span aria-hidden="true">↗</span></a>
  </section>}

  {page.kind === 'access' && <section class="guide-page-content section-wrap">
    <header><p class="eyebrow">PLAN THE ROAD</p><h2>Into southwestern<br /><em>Nagano.</em></h2><p>{region.accessNote}</p></header>
    <div class="route-grid">{region.accessRoutes.map(route => <article><p>{route.origin}</p><strong>{route.duration}</strong><span>{route.route}</span></article>)}</div>
    <div class="access-advice"><h3>Before departure</h3><p>The published times are approximate driving times. Check live navigation, road restrictions, weather and winter equipment requirements. Confirm any public transport separately before relying on it.</p></div>
    <a class="text-link" href="https://neba-nagano.com/?page_id=897">Official access information <span aria-hidden="true">↗</span></a>
  </section>}

  <section class="guide-page-note"><div class="section-wrap"><p class="eyebrow">AN INDEPENDENT ENGLISH GUIDE</p><p>RURAL JAPAN rewrites factual visitor information for international readers. This page is not an official translation. Details may change; confirm them with the venue or the <a href={region.visitorUrl}>Neba Tourism Association ↗</a>.</p><a class="button button-cream" href={`/places/${region.slug}/`}>Back to the full {region.name} guide <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>
